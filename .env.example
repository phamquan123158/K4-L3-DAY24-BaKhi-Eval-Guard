# Required
OPENAI_API_KEY=

# Optional: HuggingFace token (only if using HF Inference Endpoints)
HF_TOKEN=

# Optional: Gemini guard calls default to 4.5s spacing for 15 RPM free-tier.
# The wait spaces live requests but sits outside measured NeMo service latency.
# Use 0 only if quota permits.
GUARD_REQUEST_INTERVAL_SECONDS=4.5
